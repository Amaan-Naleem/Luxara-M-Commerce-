<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.MainActivity">
    <!--boittom naviation starts  here-->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF">


        <!--        search bar section box  codes  start here-->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:paddingTop="32dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:navigationIcon="@drawable/menu">


            <EditText
                android:id="@+id/text_iput_search"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/search_bg"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="10dp"
                android:hint="@string/search_hint"
                android:importantForAutofill="no"
                android:inputType="text"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textSize="14sp" />
        </com.google.android.material.appbar.MaterialToolbar>
        <!--        search bar section box  codes  ends here-->

        <!--        this is middle start  box  -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fragment_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#FFFFFF"
            app:layout_constraintBottom_toTopOf="@id/bottom_navigation_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbar" />
        <!--        this is middle start  box  -->


        <!--        bottom navugation  code start here -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:itemIconTint="@drawable/nav_custom_icon"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:menu="@menu/bottom_navigation_menu" />
        <!--        bottom navugation  code start here -->


    </androidx.constraintlayout.widget.ConstraintLayout>
    <!--boittom naviation ends  here-->


    <com.google.android.material.navigation.NavigationView
        android:id="@+id/side_navigation_view"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/md_theme_surface"
        android:elevation="16dp"
        app:dividerInsetEnd="16dp"


        app:dividerInsetStart="16dp"
        app:headerLayout="@layout/side_nav_header"
        app:itemHorizontalPadding="16dp"


        app:itemIconPadding="20dp"
        app:itemIconSize="24dp"
        app:itemIconTint="@drawable/nav_custom_icon"


        app:itemShapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
        app:itemShapeFillColor="@color/md_theme_secondaryContainer"


        app:itemShapeInsetBottom="4dp"
        app:itemShapeInsetEnd="8dp"
        app:itemShapeInsetStart="8dp"
        app:itemShapeInsetTop="4dp"
        app:itemTextAppearance="@style/TextAppearance.Material3.LabelLarge"
        app:itemTextColor="@drawable/nav_custom_icon"


        app:itemVerticalPadding="6dp"
        app:menu="@menu/side_nav_menu"

        app:subheaderTextAppearance="@style/TextAppearance.Material3.LabelSmall" />
</androidx.drawerlayout.widget.DrawerLayout>
