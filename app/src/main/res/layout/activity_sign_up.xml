<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true"
    android:overScrollMode="never">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="32dp"
        android:paddingVertical="32dp">

        <!-- Decorative Top Line Accent -->
        <View
            android:id="@+id/accentLine"
            android:layout_width="48dp"
            android:layout_height="3dp"
            android:background="@color/luxara_espresso"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintVertical_bias="0.45"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/tvAppName" />

        <!-- App Name -->
        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/sign_in_app_name"
            android:textColor="@color/luxara_espresso"
            android:textSize="44sp"
            android:letterSpacing="0.4"
            android:fontFamily="serif"
            android:textStyle="bold"
            android:includeFontPadding="false"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/accentLine"
            app:layout_constraintBottom_toTopOf="@+id/tvTagline" />

        <!-- Tagline -->
        <TextView
            android:id="@+id/tvTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/sign_in_tagline"
            android:textColor="@color/luxara_espresso"
            android:alpha="0.85"
            android:textSize="16sp"
            android:letterSpacing="0.12"
            android:fontFamily="sans-serif-light"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvAppName"
            app:layout_constraintBottom_toTopOf="@+id/divider" />

        <!-- Divider -->
        <View
            android:id="@+id/divider"
            android:layout_width="40dp"
            android:layout_height="1.5dp"
            android:layout_marginTop="16dp"
            android:background="@color/luxara_espresso"
            android:alpha="0.2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTagline"
            app:layout_constraintBottom_toTopOf="@+id/tvTitle" />

        <!-- Sign Up Heading -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Create Account"
            android:textColor="@color/luxara_espresso"
            android:textSize="32sp"
            android:letterSpacing="0.04"
            android:fontFamily="serif"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider"
            app:layout_constraintBottom_toTopOf="@+id/tvSubtitle" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Join Luxara for premium fashion"
            android:textColor="@color/luxara_espresso"
            android:alpha="0.8"
            android:textSize="16sp"
            android:letterSpacing="0.02"
            android:fontFamily="sans-serif-light"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintBottom_toTopOf="@+id/cardFullName" />

        <!-- Full Name Input Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardFullName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardPreventCornerOverlap="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
            app:layout_constraintBottom_toTopOf="@+id/cardEmail">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_myplaces"
                    android:alpha="0.6"
                    android:contentDescription="Name icon" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxStrokeWidth="0dp"
                    app:boxStrokeWidthFocused="0dp"
                    app:boxBackgroundColor="#00000000"
                    app:hintTextColor="@color/luxara_espresso"
                    app:hintAnimationEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/signup_input_name"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:hint="Full Name"
                        android:inputType="textPersonName|textCapWords"
                        android:textColor="@color/luxara_espresso"
                        android:textSize="16sp"
                        android:letterSpacing="0.02"
                        android:fontFamily="sans-serif-light"
                        android:background="@null"
                        android:imeOptions="actionNext"
                        android:singleLine="true" />

                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Email Input Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardEmail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardPreventCornerOverlap="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardFullName"
            app:layout_constraintBottom_toTopOf="@+id/cardPassword">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_dialog_email"
                    android:alpha="0.6"
                    android:contentDescription="@string/email_icon_desc" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxStrokeWidth="0dp"
                    app:boxStrokeWidthFocused="0dp"
                    app:boxBackgroundColor="#00000000"
                    app:hintTextColor="@color/luxara_espresso"
                    app:hintAnimationEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/signup_input_email"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:hint="@string/email_hint"
                        android:inputType="textEmailAddress"
                        android:textColor="@color/luxara_espresso"
                        android:textSize="16sp"
                        android:letterSpacing="0.02"
                        android:fontFamily="sans-serif-light"
                        android:background="@null"
                        android:imeOptions="actionNext"
                        android:singleLine="true" />

                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Password Input Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardPassword"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardPreventCornerOverlap="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardEmail"
            app:layout_constraintBottom_toTopOf="@+id/tvPasswordHint">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_lock_lock"
                    android:alpha="0.6"
                    android:contentDescription="@string/password_icon_desc" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxStrokeWidth="0dp"
                    app:boxStrokeWidthFocused="0dp"
                    app:boxBackgroundColor="#00000000"
                    app:hintTextColor="@color/luxara_espresso"
                    app:passwordToggleEnabled="true"
                    app:passwordToggleTint="@color/luxara_espresso"
                    app:hintAnimationEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/signup_input_password"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:hint="@string/password_hint"
                        android:inputType="textPassword"
                        android:textColor="@color/luxara_espresso"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-light"
                        android:background="@null"
                        android:imeOptions="actionDone"
                        android:singleLine="true" />

                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Password Hint -->
        <TextView
            android:id="@+id/tvPasswordHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Use 8+ characters with letters and numbers"
            android:textColor="@color/luxara_espresso"
            android:alpha="0.5"
            android:textSize="12sp"
            android:fontFamily="sans-serif-light"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardPassword"
            app:layout_constraintBottom_toTopOf="@+id/signup_bn_signup" />

        <!-- Sign Up Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/signup_bn_signup"
            android:layout_width="0dp"
            android:layout_height="62dp"
            android:layout_marginTop="24dp"
            android:text="CREATE ACCOUNT"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:letterSpacing="0.18"
            android:fontFamily="sans-serif-medium"
            app:backgroundTint="@color/luxara_espresso"
            app:cornerRadius="16dp"
            app:elevation="6dp"
            app:rippleColor="#33FFFFFF"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvPasswordHint"
            app:layout_constraintBottom_toTopOf="@+id/signInLayout" />

        <!-- Already have account -->
        <LinearLayout
            android:id="@+id/signInLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="horizontal"
            android:gravity="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/signup_bn_signup"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Already have an account? "
                android:textColor="@color/luxara_espresso"
                android:alpha="0.8"
                android:textSize="16sp"
                android:fontFamily="sans-serif-light" />

            <TextView
                android:id="@+id/signup_btn_signin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_page"
                android:textColor="@color/luxara_espresso"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>