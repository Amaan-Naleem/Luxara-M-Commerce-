<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="200dp"
    android:orientation="vertical"
    android:padding="24dp"
    android:paddingBottom="20dp"
    android:gravity="bottom"
    android:background="@drawable/nav_header_background">

    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginBottom="14dp">

        <ImageView
            android:id="@+id/header_profile_pic"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_default_avatar"
            android:scaleType="centerCrop"
            android:background="@drawable/circle_profile_border"
            android:clipToOutline="true"
            android:elevation="2dp"
            android:contentDescription="Profile Picture" />

    </FrameLayout>

    <TextView
        android:id="@+id/header_user_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Alexandra Monroe"
        android:textColor="@color/color_text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.02"
        android:layout_marginBottom="2dp" />

    <TextView
        android:id="@+id/header_user_email"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="alexandra@luxara.com"
        android:textColor="@color/color_text_secondary"
        android:textSize="13sp"
        android:fontFamily="sans-serif"
        android:letterSpacing="0.01" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:gravity="start">

        <TextView
            android:id="@+id/tv_membership_badge"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/badge_background"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.1"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="@string/side_nav_luxe_member"
            android:textColor="@color/color_gold_accent"
            android:textSize="10sp" />

    </LinearLayout>

</LinearLayout>