<?xml version="1.0" encoding="utf-8"?>
<!--
    corner_ornament_tr.xml  (Top-Right)
    Place in: res/drawable/corner_ornament_tr.xml
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Right vertical stroke -->
    <item
        android:left="28dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#A89278" />
            <size android:width="1dp" android:height="30dp" />
        </shape>
    </item>
    <!-- Top horizontal stroke -->
    <item
        android:bottom="28dp"
        android:left="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#A89278" />
            <size android:width="30dp" android:height="1dp" />
        </shape>
    </item>
</layer-list>