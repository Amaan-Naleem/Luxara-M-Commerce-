<?xml version="1.0" encoding="utf-8"?>
<!--
    nav_header_background_dark.xml
    Usage: android:background="@drawable/nav_header_background_dark"
    Apply to the root layout of the nav header.
    Deep warm-black with a subtle dark border for depth.
    For the radial gold glow effect shown in the preview, you will need
    to draw that programmatically in code using Canvas or use a
    custom View — XML gradients only support linear/radial/sweep on
    the whole shape, not positioned ambient glows.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base dark warm-black fill -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0E0B08" />
        </shape>
    </item>

    <!-- Subtle top-right gold ambient glow via radial gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="200%"
                android:startColor="#18D4AF37"
                android:endColor="#00D4AF37"
                android:centerX="0.85"
                android:centerY="0.0" />
        </shape>
    </item>

    <!-- Thin gold top border line for premium finish -->
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#000000" />
        </shape>
    </item>
    <item android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#00D4AF37"
                android:centerColor="#80D4AF37"
                android:endColor="#00D4AF37" />
            <size android:height="1dp" />
        </shape>
    </item>

</layer-list>
