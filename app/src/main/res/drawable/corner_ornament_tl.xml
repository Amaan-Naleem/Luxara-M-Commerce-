<?xml version="1.0" encoding="utf-8"?>
<!--
    corner_ornament_tl.xml  (Top-Left)
    Place in: res/drawable/corner_ornament_tl.xml
    L-shaped bracket using two thin lines — drawn as borders on two sides.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
<!-- Left vertical stroke -->
<item
    android:right="28dp"
    android:bottom="0dp">
    <shape android:shape="rectangle">
        <solid android:color="#A89278" />
        <size android:width="1dp" android:height="30dp" />
    </shape>
</item>
<!-- Top horizontal stroke -->
<item
    android:bottom="28dp"
    android:right="0dp">
    <shape android:shape="rectangle">
        <solid android:color="#A89278" />
        <size android:width="30dp" android:height="1dp" />
    </shape>
</item>
</layer-list>