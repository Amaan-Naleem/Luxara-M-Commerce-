<?xml version="1.0" encoding="utf-8"?>
<!--
    ic_hanger.xml
    Place in: res/drawable/ic_hanger.xml
    A minimal luxury clothing hanger icon in warm gold tones.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="140dp"
    android:height="100dp"
    android:viewportWidth="140"
    android:viewportHeight="100">

    <!-- Hook circle at top -->
    <path
        android:pathData="M70,14 m-7,0 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0"
        android:strokeColor="#A89278"
        android:strokeWidth="1.5"
        android:fillColor="#00000000" />

    <!-- Hook curl upward to the right -->
    <path
        android:pathData="M70,7 Q70,0 78,0 Q86,0 88,8"
        android:strokeColor="#A89278"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Vertical neck from hook down to shoulders -->
    <path
        android:pathData="M70,21 L70,36"
        android:strokeColor="#A89278"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Left shoulder sweep -->
    <path
        android:pathData="M70,36 Q50,46 20,68"
        android:strokeColor="#A89278"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Right shoulder sweep -->
    <path
        android:pathData="M70,36 Q90,46 120,68"
        android:strokeColor="#A89278"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Bottom bar left cap -->
    <path
        android:pathData="M20,68 Q20,76 28,76 L112,76 Q120,76 120,68"
        android:strokeColor="#A89278"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Subtle glow ellipse behind hanger (very low opacity) -->
    <path
        android:pathData="M30,62 Q70,75 110,62 Q110,70 70,74 Q30,70 30,62Z"
        android:fillColor="#C4A882"
        android:fillAlpha="0.08" />

</vector>