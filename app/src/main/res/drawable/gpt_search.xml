<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Focused -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FFFFFF"
                android:endColor="#F5F5F5"
                android:angle="270"/>

            <corners android:radius="30dp"/>

            <stroke
                android:width="2dp"
                android:color="#6200EE"/>

            <padding
                android:left="16dp"
                android:right="16dp"
                android:top="10dp"
                android:bottom="10dp"/>
        </shape>
    </item>

    <!-- Default -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FFFFFF"
                android:endColor="#FAFAFA"
                android:angle="270"/>

            <corners android:radius="30dp"/>

            <stroke
                android:width="1dp"
                android:color="#E0E0E0"/>

            <padding
                android:left="16dp"
                android:right="16dp"
                android:top="10dp"
                android:bottom="10dp"/>
        </shape>
    </item>

</selector>