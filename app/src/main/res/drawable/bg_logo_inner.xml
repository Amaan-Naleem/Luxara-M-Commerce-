<?xml version="1.0" encoding="utf-8"?>
<!-- res/drawable/bg_logo_inner.xml -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:startColor="#1E1E30"
                android:endColor="#141420"
                android:angle="135" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#22FF6B35" />
            <corners android:radius="22dp" />
            <solid android:color="#00000000" />
        </shape>
    </item>
</layer-list>